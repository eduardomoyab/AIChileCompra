# Proveedor de LLM por defecto (openai, gemini, deepseek)
DEFAULT_LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
# Otras opciones: gpt-3.5-turbo, gpt-4, gpt-4-1106-preview

# Google Gemini Configuration
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-pro
# Otras opciones: gemini-pro-vision

# DeepSeek Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

CU_USER=tu_usuario_clave_unica
CU_PASSWORD=tu_password_clave_unica
GECKO_DRIVER_PATH=C:/SeleniumDrivers/geckodriver.exe
ATTACHMENTS_OUTPUT_PATH=attachments

# Vector Store Configuration
VECTORSTORE_PERSIST_DIR=./chroma_db
VECTORSTORE_COLLECTION_NAME=catalogacion_default
EMBEDDING_MODEL=models/text-embedding-004

# Diccionarios - Chunk Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Catalogación - Temperaturas LLM
TEMPERATURE_ADJUNTOS=0.7
TEMPERATURE_DICCIONARIOS=0.3

# Catalogación - Retrieval
SEARCH_K_ADJUNTOS=5
SEARCH_K_DICCIONARIOS=2
# API Configuration
API_KEY=your-secret-api-key-change-this-in-production
API_HOST=0.0.0.0
API_PORT=8000
