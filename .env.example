# Proveedor de LLM por defecto (openai, gemini, deepseek)
DEFAULT_LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Otras opciones: gpt-4o, gpt-4o-mini, gpt-4-turbo-preview, gpt-3.5-turbo

# Google Gemini Configuration
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Otras opciones: gemini-pro-vision

# DeepSeek Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ChileCompra - Adjuntos
# Las claves de la API pública del Buscador están embebidas en get_attachments.py
# y no requieren configuración adicional.
ATTACHMENTS_OUTPUT_PATH=attachments

# Vector Store Configuration (FAISS)
VECTORSTORE_PERSIST_DIR=./faiss_db
VECTORSTORE_COLLECTION_NAME=catalogacion_default
EMBEDDING_MODEL=text-embedding-3-small

# Diccionarios - Chunk Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Catalogación - Temperaturas LLM
TEMPERATURE_ADJUNTOS=0.7
TEMPERATURE_DICCIONARIOS=0.3

# Catalogación - Retrieval
SEARCH_K_ADJUNTOS=5
SEARCH_K_DICCIONARIOS=2

# Catalogación - Adjuntos (Atributos Fijos: Tipo, Part Number, Modelo)
ADJUNTOS_CHUNK_SIZE=500
ADJUNTOS_CHUNK_OVERLAP=100
# Patrones de nombre de archivo a excluir del FAISS (formularios admin, no fichas técnicas)
SKIP_FILENAME_PATTERNS=anexo,formulario,propuesta,simulacion
# Keywords técnicas en el nombre: si aparece alguna, se conserva aunque tenga patrón admin
TECH_FILENAME_KEYWORDS=procesador,cpu,ram,memoria,ssd,hdd,disco,pantalla,monitor,display,intel,amd,nvidia,gpu,ficha,especificacion,tecnica,tecnico,almacenamiento,bateria,ghz

# Catalogación - Campos Manuales (Extracción Paralela)
CAMPOS_MANUALES_MAX_WORKERS=3
CAMPOS_MANUALES_MAX_RETRIES=3
CAMPOS_MANUALES_INITIAL_DELAY=2.0
CAMPOS_MANUALES_CHUNK_SIZE=500
CAMPOS_MANUALES_CHUNK_OVERLAP=100
CAMPOS_MANUALES_SEARCH_K=4

# API Configuration
API_KEY=your-secret-api-key-change-this-in-production
API_HOST=0.0.0.0
API_PORT=8000

# Fix para conflicto de OpenMP con FAISS
KMP_DUPLICATE_LIB_OK=TRUE

# LangSmith (opcional, para trazabilidad de llamadas LLM)
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=ChileCompraTest
